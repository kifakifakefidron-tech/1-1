# Адрес сайта. Пока нет своего домена — бесплатный адрес по IP сервера
# (setup.sh подставит сам). Когда купите домен — впишите его сюда и
# выполните: docker compose up -d
SITE_DOMAIN=31-130-132-118.sslip.io

# Ключ DeepSeek (platform.deepseek.com). Без ключа разбор идёт только правилами.
DEEPSEEK_API_KEY=

# Wappi: токен и ID профиля из личного кабинета — на каждый тип аккаунта.
# Пусто — этот аккаунт не опрашивается (сайт работает и без них).
WAPPI_TOKEN_WA=
WAPPI_PROFILE_WA=
WAPPI_TOKEN_TG=
WAPPI_PROFILE_TG=
WAPPI_TOKEN_MAX=
WAPPI_PROFILE_MAX=
WAPPI_POLL_SECONDS=90
WAPPI_BACKFILL_HOURS=48
WAPPI_GROUPS_ONLY=true
WAPPI_INCLUDE_FROM_ME=false

# Код для коллег: с ним видны телефоны агентов и исходные сообщения
ACCESS_CODE=
PUBLIC_CONTACT=https://wa.me/79618571772
PUBLIC_CONTACT_LABEL=Узнать подробности
# Длинная случайная строка (setup.sh сгенерирует сам)
SECRET_KEY=

STALE_DAYS=45
GEOCODER=nominatim
