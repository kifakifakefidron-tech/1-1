# Адрес сайта. Пока нет своего домена — бесплатный адрес по IP сервера
# (setup.sh подставит сам). Когда купите домен — впишите его сюда и
# выполните: docker compose up -d
SITE_DOMAIN=31-130-132-118.sslip.io

# Ключ DeepSeek (platform.deepseek.com). Без ключа разбор идёт только правилами.
DEEPSEEK_API_KEY=

# Wappi: токен и ID профиля из личного кабинета — на каждый тип аккаунта.
# Пусто — этот аккаунт не опрашивается (сайт работает и без них).
WAPPI_TOKEN_WA=
WAPPI_PROFILE_WA=
WAPPI_TOKEN_TG=
WAPPI_PROFILE_TG=
WAPPI_TOKEN_MAX=
WAPPI_PROFILE_MAX=
# false — сбор новых сообщений на паузе (уже скачанные разбираются)
WAPPI_ENABLED=true
WAPPI_POLL_SECONDS=90
WAPPI_BACKFILL_HOURS=48
WAPPI_GROUPS_ONLY=true
WAPPI_INCLUDE_FROM_ME=false

# Код для коллег: с ним видны телефоны агентов и исходные сообщения
ACCESS_CODE=
# Телефон партнёра СТРЕЛЫ для объектов из фида — виден только подписчикам, как телефоны агентов
FEED_PHONE=+79618571772
# Чаты и посёлки с этими словами не берём (пока работаем только по Краснодару); пусто — список по умолчанию
# BLOCKED_PLACES=сочи,адлер,сириус,туапсе,анап,геленджик
# Длинная случайная строка (setup.sh сгенерирует сам)
SECRET_KEY=

# Объект скрывается, если его не присылали столько дней; через KEEP_DAYS — удаляется
STALE_DAYS=20
KEEP_DAYS=90
GEOCODER=nominatim
# Проба Яндекс Геокодера (python -m app.yandex_trial): ключ «JavaScript API и HTTP Геокодер»
# из кабинета разработчика Яндекса. Пока только для пробы — в базу ничего не пишется.
YANDEX_GEOCODER_KEY=

# Уведомления о сбоях в Telegram: токен бота от @BotFather; получатель пишет боту /start
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN=ArtemAndreevic1
# Ник бота без @ (необязательно — сайт узнает сам)
TELEGRAM_BOT_USERNAME=

# ─── Личный кабинет ───────────────────────────────────────────────────────
# Неделя бесплатно (раз на номер), потом подписка: цена и период
TRIAL_DAYS=7
SUB_PRICE=49
SUB_DAYS=7
# Сколько разных объектов в сутки подписчик может открыть номера (защита базы)
PHONE_VIEWS_PER_DAY=0
# Почты администраторов (через запятую) — для входа в админку по почте
ADMIN_EMAILS=

# Почта для кодов входа: Яндекс, пароль приложения (не обычный пароль!)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Оплата ЮKassa — пока выключена
PAYMENTS_ENABLED=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET=

# Если сервер не видит Telegram (ошибка «Network is unreachable» в журнале бота):
# прокси http://логин:пароль@IP:порт или своё зеркало API
TELEGRAM_PROXY=
TELEGRAM_API_BASE=

# Пробная неделя при первом входе по почте (раз на адрес)
TRIAL_BY_EMAIL=true
# Почта для уведомлений о сбоях (если пусто — первый из ADMIN_EMAILS)
ALERT_EMAIL=

# Данные для политики конфиденциальности и соглашения
OPERATOR_NAME=
OPERATOR_INN=
CONTACT_EMAIL=

# ─── Кабинет агента ───
# Наш номер, на который агенты присылают код подтверждения (номер, подключённый в Wappi к MAX/WhatsApp)
VERIFY_NUMBER=
# Где принимаем код: max, wa (через запятую)
VERIFY_CHANNELS=max,wa
# Сколько дней висит объект, добавленный агентом вручную
OWN_LISTING_DAYS=30
